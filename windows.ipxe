#!ipxe
# Override this setting in boot.cfg to use your own HTTP(S) asset server.
# Migrate the previous built-in default when returning without rebooting iPXE.
iseq ${osdcloud_base_url} https://github.com/pokys/netboot.xyz-custom/releases/download/osdcloud && clear osdcloud_base_url ||
iseq ${osdcloud_base_url} https://github.com/pokys/netboot.xyz-custom/releases/download/osdcloud-v2 && clear osdcloud_base_url ||
iseq ${osdcloud_base_url} https://github.com/pokys/netboot.xyz-custom/releases/download/osdcloud-v3 && clear osdcloud_base_url ||
iseq ${osdcloud_base_url} https://github.com/pokys/netboot.xyz-custom/releases/download/osdcloud-v4 && clear osdcloud_base_url ||
iseq ${osdcloud_base_url} https://github.com/pokys/netboot.xyz-custom/releases/download/osdcloud-v5 && clear osdcloud_base_url ||
iseq ${osdcloud_base_url} https://github.com/pokys/netboot.xyz-custom/releases/download/osdcloud-v6 && clear osdcloud_base_url ||
iseq ${osdcloud_base_url} https://github.com/pokys/netboot.xyz-custom/releases/download/osdcloud-v7 && clear osdcloud_base_url ||
iseq ${osdcloud_base_url} https://github.com/pokys/netboot.xyz-custom/releases/download/osdcloud-v8 && clear osdcloud_base_url ||
iseq ${osdcloud_base_url} https://github.com/pokys/netboot.xyz-custom/releases/download/osdcloud-v9 && clear osdcloud_base_url ||
isset ${osdcloud_base_url} || set osdcloud_base_url https://github.com/pokys/netboot.xyz-custom/releases/download/osdcloud-v10

:windows
menu Windows 10 / 11 - OSDCloud installer
item --gap Choose Windows 10 22H2 or a Windows 11 release in the WinPE wizard.
item --gap Downloads Windows from Microsoft after WinPE starts.
item --gap Windows deployment requires UEFI; BIOS PE boot is for diagnostics.
item --gap Installation can erase internal disks. Review every confirmation.
item start Boot Windows PE / OSDCloud (64-bit PC - BIOS or x64 UEFI)
item url Change boot asset URL [${osdcloud_base_url}]
item back Return to custom menu
choose --default back osdcloud_choice || goto back
goto ${osdcloud_choice}

:url
echo Enter the directory containing boot.wim, wimboot, BCD and boot.sdi (no trailing slash):
read osdcloud_base_url || goto windows
goto windows

:start
# BIOS iPXE is commonly compiled for i386 even on a 64-bit processor.
iseq ${platform} pcbios && goto check_cpu ||
iseq ${platform} efi || goto unsupported
iseq ${buildarch} x86_64 || goto unsupported

:check_cpu
cpuid --ext 29 || goto unsupported
imgfree
echo Boot platform: ${platform} - iPXE build: ${buildarch}
kernel ${osdcloud_base_url}/wimboot || goto failed
initrd --name BCD ${osdcloud_base_url}/BCD BCD || goto failed
initrd --name boot.sdi ${osdcloud_base_url}/boot.sdi boot.sdi || goto failed
initrd --name boot.wim ${osdcloud_base_url}/boot.wim boot.wim || goto failed
boot || goto failed

:unsupported
echo This entry requires a 64-bit x86 PC with BIOS or x64 UEFI iPXE.
echo Detected platform: ${platform} - iPXE build: ${buildarch}
prompt Press any key to return... ||
goto windows

:failed
imgfree
echo Could not load OSDCloud. Check that boot.wim, wimboot, BCD and boot.sdi are available.
prompt Press any key to return... ||
goto windows

:back
exit 0
