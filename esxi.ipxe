:esxi_boot
imgfree
echo Source: ${esxi_source}
echo URL: ${esxi_url}
echo Starting ${esxi_image}
sanboot --no-describe --drive 0x80 ${esxi_url} || goto esxi_failed
goto ${esxi_return}

:esxi_failed
echo ISO boot failed. Check source access and iPXE HTTP(S) SAN support.
echo For firmware ISO limitations, use extracted ESXi media over HTTP.
menu ESXi - Download or boot failed
item esxi_retry ${space} Retry this source
item esxi_return_to_list ${space} Return to image list
item esxi_menu ${space} Select another download source
choose --default esxi_return_to_list esxi_choice || goto esxi_return_to_list
goto ${esxi_choice}

:esxi_retry
goto esxi_boot

:esxi_return_to_list
goto ${esxi_return}

:esxi_back
clear esxi_choice
clear esxi_image
clear esxi_url
clear esxi_return
clear esxi_source
exit 0
