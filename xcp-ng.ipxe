#!ipxe
# Official XCP-ng ISO index reviewed 2026-10-16.
# Small HTTP Range/ISO9660 checks passed; full hashes and booting are untested.

:xcp_menu
menu XCP-ng - Official downloads
item --gap Source: updates.xcp-ng.org
item xcp_family_8_3 ${space} XCP-ng 8.3 - LTS
item xcp_family_8_2 ${space} XCP-ng 8.2 - Historical
item xcp_family_8_1 ${space} XCP-ng 8.1 - Historical
item xcp_family_8_0 ${space} XCP-ng 8.0 - Historical
item xcp_family_7_6 ${space} XCP-ng 7.6 - Historical
item xcp_family_7_5 ${space} XCP-ng 7.5 - Historical
item xcp_back ${space} Return to custom menu
choose --default xcp_back xcp_choice || goto xcp_back
goto ${xcp_choice}

:xcp_family_8_3
menu XCP-ng 8.3 - updates.xcp-ng.org
item --gap Netinstall requires a network package source in the installer
item xcp_8_3_0_20260806 ${space} 8.3.0-20260806 - Full ISO
item xcp_8_3_0_20260806_netinstall ${space} 8.3.0-20260806 - Netinstall
