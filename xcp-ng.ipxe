:xcp_boot
imgfree
echo Source: XCP-ng - updates.xcp-ng.org
echo ISO: ${xcp_image}
echo URL: ${xcp_url}
sanboot --no-describe --drive 0x80 ${xcp_url} || goto xcp_failed
goto ${xcp_return}

:xcp_failed
echo ISO boot failed. Check source access and firmware HTTP(S) SAN boot support.
echo XCP-ng also supports installation from extracted media over HTTP.
menu XCP-ng - Download or boot failed
item xcp_boot ${space} Retry this ISO
item xcp_return_to_list ${space} Return to image list
item xcp_back ${space} Return to custom menu
choose --default xcp_return_to_list xcp_choice || goto xcp_return_to_list
goto ${xcp_choice}

:xcp_return_to_list
goto ${xcp_return}

:xcp_back
clear xcp_choice
clear xcp_image
clear xcp_url
clear xcp_return
exit 0
