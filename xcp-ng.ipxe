goto ${xcp_choice}

:xcp_8_3_0_20260806
set xcp_return xcp_family_8_3
set xcp_image xcp-ng-8.3.0-20260806.iso
set xcp_url https://updates.xcp-ng.org/isos/8.3/xcp-ng-8.3.0-20260806.iso
goto xcp_boot

