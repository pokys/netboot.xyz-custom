#!ipxe
###
### netboot.xyz custom boot menu
###

:custom
clear custom_choice
menu Custom Boot Menu
item --gap Windows
item windows_osdcloud ${space} Windows 10 / 11 - OSDCloud installer
item windows_eval ${space} Windows 11 - Microsoft Evaluation
item windows_server ${space} Windows Server - Microsoft Evaluation
item --gap Virtualization
item esxi ${space} VMware ESXi - Select source
item xcp_ng ${space} XCP-ng - Official downloads
item --gap Storage / NAS
item truenas ${space} TrueNAS Community Edition - Installer
item --gap Live tools
item alpine_docker ${space} Alpine Live - Docker + Dockge + SSH
item alpine_apps ${space} Alpine Live - App appliances
item alpine_tailcat ${space} Alpine Live - Tailcat-OneShot
item puppy ${space} Puppy Linux - BookwormPup64
item slax ${space} Slax - Debian
choose custom_choice || goto custom_exit
echo ${cls}
goto ${custom_choice}
goto custom_exit

:windows_osdcloud
chain --autofree https://raw.githubusercontent.com/pokys/netboot.xyz-custom/master/windows.ipxe || goto custom_exit
goto custom

:windows_eval
chain --autofree https://raw.githubusercontent.com/pokys/netboot.xyz-custom/master/windows-eval.ipxe || goto custom_exit
goto custom

:windows_server
chain --autofree https://raw.githubusercontent.com/pokys/netboot.xyz-custom/master/windows-server.ipxe || goto custom_exit
goto custom

:esxi
chain --autofree https://raw.githubusercontent.com/pokys/netboot.xyz-custom/master/esxi.ipxe || goto custom_exit
goto custom

:xcp_ng
chain --autofree https://raw.githubusercontent.com/pokys/netboot.xyz-custom/master/xcp-ng.ipxe || goto custom_exit
goto custom

:truenas
chain --autofree https://raw.githubusercontent.com/pokys/netboot.xyz-custom/master/truenas.ipxe || goto custom_exit
goto custom

:alpine_docker
chain --autofree https://raw.githubusercontent.com/pokys/netboot.xyz-custom/master/alpine-docker.ipxe || goto custom_exit
goto custom

:alpine_tailcat
chain --autofree https://raw.githubusercontent.com/pokys/netboot.xyz-custom/master/alpine-tailcat.ipxe || goto custom_exit
goto custom

:puppy
chain --autofree https://raw.githubusercontent.com/pokys/netboot.xyz-custom/master/puppy.ipxe || goto custom_exit
goto custom

:slax
chain --autofree https://raw.githubusercontent.com/pokys/netboot.xyz-custom/master/slax.ipxe || goto custom_exit
goto custom

:alpine_apps
chain --autofree https://raw.githubusercontent.com/pokys/netboot.xyz-custom/master/alpine-apps.ipxe || goto custom_exit
goto custom

:custom_exit
echo Boot failed. Returning to menu
clear menu
